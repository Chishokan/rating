# Claude (Anthropic) API キー。https://console.anthropic.com で取得してください。
# .env.local にコピーして実際のキーを設定します。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# （任意）保存ログを Google スプレッドシートに記録する GAS ウェブアプリの URL。
# gas/Code.gs をスプレッドシートの Apps Script に貼り付け、ウェブアプリとして
# デプロイした URL を設定します。未設定の場合、ログ記録はスキップされます。
GAS_LOG_URL=
